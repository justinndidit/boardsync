POSTGRES_DB=boardsync_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_CONNECTION=redis:6379

# ── Where the deployment lives ───────────────────────────────────────────────
#
# DOMAIN is the hostname Caddy issues a certificate for and the only name the site answers on.
# It must already resolve to this host's public IP before the stack starts, or the ACME challenge
# fails and you get no certificate. A bare hostname, no scheme.
DOMAIN=boardsync.example.com

# Let's Encrypt mails this address before a certificate lapses — the warning you want if renewal
# has quietly been failing.
ACME_EMAIL=ops@example.com

# The browser origin. Production refuses to start when this is empty, and it is what invitation
# links are built from, so it has to be the real public URL — https://${DOMAIN}, not localhost.
APP_ORIGIN=https://boardsync.example.com

# Where the API is reachable, for the confirmation and password-reset links, which are API
# endpoints rather than app screens. Same host in this stack: nginx routes /api to the API.
APP_BASE_URL=https://boardsync.example.com

# The network the containers sit on, for trusting forwarded headers. The default matches Docker's
# standard bridge pool and only needs changing if you have moved it.
# DOCKER_NETWORK_CIDR=172.16.0.0/12

JWT_SECRET=replace-with-a-strong-32-char-min-secret
JWT_ISSUER=BoardSync.Api
JWT_AUDIENCE=BoardSync.Client

SMTP_SERVER=localhost
SENDER_EMAIL=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Language model for Modules/Intelligence — PRD decomposition and sprint narratives.
#
# Optional. Without a key both features answer "not configured" and everything else, including every
# computed figure on the reports page, works exactly as before.
#
# INTELLIGENCE_PROVIDER picks which one: Anthropic (default) or Gemini. Set the matching key —
# a key for the provider you are not using does nothing, and the startup log says which it wants.
INTELLIGENCE_PROVIDER=Anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. Model names move faster than releases do.
GEMINI_MODEL=

# Object storage for profile pictures — an Azure Storage connection string with an account key.
#
# Optional. Without it the two upload endpoints answer 503 "not configured", the UI hides the
# upload control, and every avatar already set still renders — the URL lives on the user row.
#
# Local development needs nothing here: appsettings.Development.json already points at the Azurite
# container in docker-compose.dev.yaml. This is for deployed environments.
#
# The key must be an account key, not a SAS: the API signs its own short-lived upload URLs, which
# a SAS-only credential cannot do.
STORAGE_CONNECTION_STRING=
